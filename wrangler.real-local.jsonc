{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cauce-real-local-only",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/*"],
  },
  "vars": {
    "MODE": "real",
    "APP_ORIGIN": "http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cauce-real-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "remote": false,
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FEED_IMAGES", "bucket_name": "alveo-feed-images" }],
  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "cauce-real-local-sync" },
    ],
    "consumers": [
      {
        "queue": "cauce-real-local-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
      },
    ],
  },
}
